# =============================================================
# life_home — repo-wide gitignore
# =============================================================

# -------- Per user request: keep local, do not commit --------
docs/sources/
docs/superpowers/

# xreal_head_control is a separate git project; keep it out of
# this repo until it is converted to a proper git submodule.
# (It currently has uncommitted local changes — push those first,
#  then convert. See README.md > "Converting xreal_head_control
#  to a submodule".)
xreal_head_control/

# -------- Editor / IDE --------
.vscode/browse.vc.db
.vscode/browse.vc.db-*
.vscode/ipch/
.vscode/.browse.VC.db*
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------- Python --------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

